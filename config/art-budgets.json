{
  "version": 1,
  "units": "pixels and bytes; KiB = 1024 bytes",
  "budgets": {
    "card":       {"max_long": 768,  "max_short": 512,  "max_bytes": 256000},
    "portrait":   {"max_long": 960,  "max_short": 640,  "max_bytes": 256000},
    "avatar":     {"max_long": 320,  "max_short": 256,  "max_bytes": 81920},
    "coin":       {"max_long": 256,  "max_short": 256,  "max_bytes": 81920},
    "background": {"max_long": 1920, "max_short": 1080, "max_bytes": 614400},
    "actor":      {"max_long": 1280, "max_short": 854,  "max_bytes": 460800},
    "frame":      {"max_long": 1024, "max_short": 1024, "max_bytes": 358400},
    "slice":      {"max_long": 512,  "max_short": 128,  "max_bytes": 61440},
    "icon":       {"max_long": 256,  "max_short": 256,  "max_bytes": 20480},
    "prop":       {"max_long": 512, "max_short": 512, "max_bytes": 102400},
    "source":     {"max_long": 2048, "max_short": 1536, "max_bytes": 5242880}
  },
  "rules": [
    {"pattern": "storage/source-art/*", "kind": "source"},
    {"pattern": "assets/frames/*/originals/*", "kind": "source"},
    {"pattern": "assets/frames/*/slices/*", "kind": "slice"},
    {"pattern": "assets/frames/*", "kind": "frame"},
    {"pattern": "assets/avatars/*", "kind": "avatar"},
    {"pattern": "assets/cards/*", "kind": "card"},
    {"pattern": "assets/coins/*", "kind": "coin"},
    {"pattern": "assets/story/actors/*", "kind": "actor"},
    {"pattern": "assets/story/props/*", "kind": "prop"},
    {"pattern": "assets/story/*", "kind": "background"},
    {"pattern": "assets/environments/*", "kind": "background"},
    {"pattern": "assets/maps/*", "kind": "background"},
    {"pattern": "assets/characters/nightfall-hall.*", "kind": "background"},
    {"pattern": "assets/characters/*", "kind": "portrait"},
    {"pattern": "assets/skins/*", "kind": "portrait"},
    {"pattern": "assets/icons/*", "kind": "icon"},
    {"pattern": "assets/emblems/*", "kind": "icon"},
    {"pattern": "assets/puzzles/*", "kind": "icon"}
  ]
}
